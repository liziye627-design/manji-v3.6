# 慢记 Manji 配置示例。复制为 .env 后按需修改；不填写也能启动（使用下方默认值）。
# 本文件不含任何密钥。

# 服务监听端口
PORT=4173

# SQLite 数据库文件位置（相对项目根或绝对路径）
DB_PATH=data/manji.db

# 私密媒体存储目录（上传的照片、作品文件都保存在这里，不对外直链）
MEDIA_ROOT=data/media

# 会话有效期（小时）
SESSION_TTL_HOURS=720

# 业务时区（纪念日与"业务今天"按此时区计算，数据库保存日期字段）
BIZ_TIMEZONE=Asia/Shanghai

# 单张照片上限（MiB）
MAX_UPLOAD_MIB=10

# 每人每件回忆最多照片数
MAX_PHOTOS_PER_MEMORY=6

# 单份正文最多字数
MAX_TEXT_CHARS=500

# 种子管理员账号（首次启动自动创建；只在服务端标记，不能通过请求伪造）
ADMIN_DISPLAY_NAME=admin
ADMIN_PASSWORD=admin-2026
# 永恒之链工作量证明难度（哈希前导 0 的十六进制位数，默认 4，越大镌刻越慢）
CHAIN_DIFFICULTY=4

# ---- v3.6 公共链锚定（BOT Chain / 任意 EVM 兼容链）----
# 三项都填写后开启；留空则功能整体关闭，本地永恒之链不受影响。
# BOT Chain 测试网：RPC https://rpc.bohr.life  链号 968  浏览器 https://scan.bohr.life
# BOT Chain 主网：  RPC https://rpc.botchain.ai 链号 677  浏览器 https://scan.botchain.ai
ONCHAIN_RPC_URL=https://rpc.bohr.life
ONCHAIN_CHAIN_ID=968
# 部署 contracts/ManjiEternalChain.sol 后得到的合约地址（0x…）
ONCHAIN_CONTRACT=
# 统一代提交账户（relayer）私钥。填写后需 `npm i ethers`，后台每 15 秒自动提交待办承诺；
# 留空为手动模式：应用给出 calldata，运营者用 Remix/MetaMask 发送后回填交易哈希。
# 该账户只用于发交易登记哈希，不接触任何资金与正文，请用专用新钱包。
ONCHAIN_RELAYER_KEY=
# 交易浏览器链接前缀（不填按链号自动选择 BOT Chain 主网/测试网）
# ONCHAIN_EXPLORER=https://scan.bohr.life

